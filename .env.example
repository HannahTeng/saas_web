# Orders store (added automatically by the Vercel ↔ Upstash Redis integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Order emails to support@flowact.net (resend.com → API Keys; verify flowact.net under Domains)
RESEND_API_KEY=
RESEND_FROM="Flowact Orders <orders@flowact.net>"
NOTIFY_EMAIL=support@flowact.net

# /admin sign-in
ADMIN_USER=
ADMIN_PASSWORD=

# Optional: also POST each order as JSON (Slack, Zapier, Google Sheets…)
REQUEST_WEBHOOK_URL=

# Flowact Ops inbox (main channel): every order becomes a lead in the Flowact app
FLOWACT_INTAKE_URL=https://app.flowact.net/api/intake
# Same value as INTAKE_SECRET in the Flowact app
FLOWACT_INTAKE_SECRET=
