# Orders store (added automatically by the Vercel ↔ Upstash Redis integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Order emails to support@flowact.net (resend.com → API Keys; verify flowact.net under Domains)
RESEND_API_KEY=
RESEND_FROM="Flowact Orders <orders@flowact.net>"
NOTIFY_EMAIL=support@flowact.net

# /admin sign-in
ADMIN_USER=
ADMIN_PASSWORD=

# Optional: also POST each order as JSON (Slack, Zapier, Google Sheets…)
REQUEST_WEBHOOK_URL=

# --- $39 scoping-call payment (set ONE of these) ---
# Preferred: secret key → the site creates a Stripe Checkout Session per order (order id in metadata).
STRIPE_SECRET_KEY=
# Or: a Stripe Payment Link for the $39 scoping call (Stripe dashboard → Payment Links). Order id is passed as client_reference_id.
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=
# Optional
SCOPING_PRICE_CENTS=3900
NEXT_PUBLIC_SITE_URL=https://flowact.net
